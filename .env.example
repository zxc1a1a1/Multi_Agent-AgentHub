# AgentHub local configuration template. Copy locally; do not commit real values.
# Provider and Agent credentials must never be exposed through VITE_* variables.

# Optional provider configuration. Keep all secret values empty.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
ORCHESTRATOR_LLM_PROVIDER=
ORCHESTRATOR_LLM_MODEL=
ORCHESTRATOR_LLM_API_KEY=
CODE_AGENT_LLM_MODEL=
CODE_AGENT_LLM_API_KEY=
WEB_AGENT_LLM_MODEL=
WEB_AGENT_LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local development only. Use empty values unless your local environment requires them.
AGENTHUB_API_TOKEN=
DATABASE_URL=

# 2.0 Target note: SQLite/WAL is the default single-node persistence profile.
# MySQL and gRPC are not implicit requirements. This template does not provision either.
