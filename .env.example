# =============================================================================
# AgentHub Docker Startup — copy to .env and fill in your values
# =============================================================================
# With just 2-3 vars, all 3 LLM services share the same credentials.
# Per-service overrides (CODE_AGENT_LLM_MODEL, etc.) still work if set.
# =============================================================================

# ---- Required: LLM API key ----
LLM_API_KEY=

# ---- Provider + Model (DeepSeek 4.1 Flash via OpenAI-compatible API) ----
# Official V4.1 Flash API model id is deepseek-flash.
# deepseek-chat is the Pro alias; deepseek-4.1-flash is rejected by the API.
LLM_PROVIDER=openai
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# ---- Orchestrator planner (LLM-only) ----
# Rule/keyword fallback was removed. The orchestrator fails startup when the
# model name or API key is missing; there is no model-less mode.
# ORCHESTRATOR_LLM_MODEL must be set; it defaults to LLM_MODEL.
# ORCHESTRATOR_LLM_PROVIDER defaults to LLM_PROVIDER, and ORCHESTRATOR_LLM_BASE_URL to LLM_BASE_URL.
# ORCHESTRATOR_PLANNER_MODE=llm is accepted for compatibility; other values fail startup.

# ---- HITL plan confirmation ----
# Set to "true" to require user confirmation before executing orchestration plans.
# When enabled, the frontend will show a plan preview card and wait for the user
# to confirm or reject before any agent tasks are dispatched.
# Default: false (plans execute immediately after generation)
# REQUIRE_PLAN_CONFIRMATION=false

# ---- Per-service overrides (uncomment if needed) ----
# ORCHESTRATOR_LLM_MODEL=
# ORCHESTRATOR_LLM_API_KEY=
# CODE_AGENT_LLM_MODEL=
# WEB_AGENT_LLM_MODEL=

# Optional: expose read-only workspace tools (list/read/search) to code-agent.
# CODE_AGENT_WORKSPACE_ROOT=/workspace
# Opt-in write tools (requires a sandbox executor/image and platform authorization).
# CODE_AGENT_ENABLE_WRITE_TOOLS=false
# CODE_AGENT_SANDBOX_IMAGE=
# CODE_AGENT_SANDBOX_EXECUTABLES=go

# Optional: enforce platform tool authorization from code-agent.
# ORCHESTRATOR_TOOL_AUTHORIZE_URL=http://orchestrator:8080/internal/orchestrator/tools/authorize
# ORCHESTRATOR_TOOL_RESULT_URL=http://orchestrator:8080/internal/orchestrator/tools/result
# ORCHESTRATOR_TOOL_TOKEN=

# ---- Gateway / Database ----
GATEWAY_PORT=8080
CODE_AGENT_PORT=8081
# Target store is MySQL. Use memory/sqlite only for explicit demo or tests.
AGENTHUB_GATEWAY_STORE=mysql
# Compose uses this to build DATABASE_URL for gateway/orchestrator.
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
AGENTHUB_API_TOKEN=

# Durable local artifact metadata directory (volume-backed in compose).
ARTIFACT_STORE_DIR=./data/artifacts

# ---- Provider-native keys (fallback, not needed if LLM_API_KEY is set) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
