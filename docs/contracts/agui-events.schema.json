{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/agui-events.schema.json",
  "title": "AgentHub AG-UI Event Schema",
  "description": "JSON Schema for AgentHub Frontend ↔ Gateway AG-UI SSE events.",
  "$ref": "#/$defs/AGUIEvent",
  "$defs": {
    "AGUIEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/RunStartedEvent"
        },
        {
          "$ref": "#/$defs/RunFinishedEvent"
        },
        {
          "$ref": "#/$defs/RunErrorEvent"
        },
        {
          "$ref": "#/$defs/TextMessageStartEvent"
        },
        {
          "$ref": "#/$defs/TextMessageContentEvent"
        },
        {
          "$ref": "#/$defs/TextMessageEndEvent"
        },
        {
          "$ref": "#/$defs/ToolCallStartEvent"
        },
        {
          "$ref": "#/$defs/ToolCallArgsEvent"
        },
        {
          "$ref": "#/$defs/ToolCallEndEvent"
        },
        {
          "$ref": "#/$defs/StateUpdateEvent"
        }
      ]
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "RunStartedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "runId"
      ],
      "properties": {
        "type": {
          "const": "RUN_STARTED"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "RunFinishedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "runId"
      ],
      "properties": {
        "type": {
          "const": "RUN_FINISHED"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "RunErrorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "RUN_ERROR"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      },
      "anyOf": [
        {
          "required": [
            "message"
          ]
        },
        {
          "required": [
            "error"
          ]
        },
        {
          "required": [
            "code"
          ]
        }
      ]
    },
    "TextMessageStartEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "messageId"
      ],
      "properties": {
        "type": {
          "const": "TEXT_MESSAGE_START"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "agent",
            "user",
            "system"
          ]
        },
        "agentName": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "TextMessageContentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "messageId",
        "content"
      ],
      "properties": {
        "type": {
          "const": "TEXT_MESSAGE_CONTENT"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "TextMessageEndEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "messageId"
      ],
      "properties": {
        "type": {
          "const": "TEXT_MESSAGE_END"
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "ToolCallStartEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "toolCallId",
        "toolName"
      ],
      "properties": {
        "type": {
          "const": "TOOL_CALL_START"
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "ToolCallArgsEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "toolCallId",
        "content"
      ],
      "properties": {
        "type": {
          "const": "TOOL_CALL_ARGS"
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "ToolCallEndEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "toolCallId"
      ],
      "properties": {
        "type": {
          "const": "TOOL_CALL_END"
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "StateUpdateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "state"
      ],
      "properties": {
        "type": {
          "const": "STATE_UPDATE"
        },
        "state": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "phase": {
              "type": "string"
            },
            "activeAgent": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "plan": {
              "type": [
                "string",
                "object",
                "array",
                "null"
              ]
            }
          }
        },
        "timestamp": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      }
    },
    "CodePreviewArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "language",
        "filename"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}