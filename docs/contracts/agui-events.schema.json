{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/agui-events.schema.json",
  "title": "AgentHub AG-UI Event",
  "oneOf": [
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/runFinished" },
    { "$ref": "#/$defs/runError" },
    { "$ref": "#/$defs/stepStarted" },
    { "$ref": "#/$defs/stepFinished" },
    { "$ref": "#/$defs/textStart" },
    { "$ref": "#/$defs/textContent" },
    { "$ref": "#/$defs/textEnd" },
    { "$ref": "#/$defs/toolStart" },
    { "$ref": "#/$defs/toolArgs" },
    { "$ref": "#/$defs/toolEnd" },
    { "$ref": "#/$defs/toolResult" },
    { "$ref": "#/$defs/stateSnapshot" },
    { "$ref": "#/$defs/stateDelta" },
    { "$ref": "#/$defs/messagesSnapshot" },
    { "$ref": "#/$defs/activitySnapshot" },
    { "$ref": "#/$defs/activityDelta" },
    { "$ref": "#/$defs/custom" },
    { "$ref": "#/$defs/raw" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "rawEvent": {}
      },
      "additionalProperties": true
    },
    "runBase": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["threadId", "runId"],
          "properties": {
            "threadId": { "type": "string" },
            "runId": { "type": "string" }
          }
        }
      ]
    },
    "runStarted": {
      "allOf": [
        { "$ref": "#/$defs/runBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RUN_STARTED" },
            "parentRunId": { "type": "string" },
            "input": {}
          }
        }
      ]
    },
    "runFinished": {
      "allOf": [
        { "$ref": "#/$defs/runBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "RUN_FINISHED" },
            "result": {},
            "outcome": {}
          }
        }
      ]
    },
    "runError": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "message"],
          "properties": {
            "type": { "const": "RUN_ERROR" },
            "message": { "type": "string" },
            "code": { "type": "string" }
          }
        }
      ]
    },
    "stepStarted": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "stepName"],
          "properties": {
            "type": { "const": "STEP_STARTED" },
            "stepName": { "type": "string" }
          }
        }
      ]
    },
    "stepFinished": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "stepName"],
          "properties": {
            "type": { "const": "STEP_FINISHED" },
            "stepName": { "type": "string" }
          }
        }
      ]
    },
    "textStart": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId", "role"],
          "properties": {
            "type": { "const": "TEXT_MESSAGE_START" },
            "messageId": { "type": "string" },
            "role": { "type": "string" }
          }
        }
      ]
    },
    "textContent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId", "delta"],
          "properties": {
            "type": { "const": "TEXT_MESSAGE_CONTENT" },
            "messageId": { "type": "string" },
            "delta": { "type": "string" }
          }
        }
      ]
    },
    "textEnd": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId"],
          "properties": {
            "type": { "const": "TEXT_MESSAGE_END" },
            "messageId": { "type": "string" }
          }
        }
      ]
    },
    "toolStart": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "toolCallId", "toolCallName"],
          "properties": {
            "type": { "const": "TOOL_CALL_START" },
            "toolCallId": { "type": "string" },
            "toolCallName": { "type": "string" },
            "parentMessageId": { "type": "string" }
          }
        }
      ]
    },
    "toolArgs": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "toolCallId", "delta"],
          "properties": {
            "type": { "const": "TOOL_CALL_ARGS" },
            "toolCallId": { "type": "string" },
            "delta": { "type": "string" }
          }
        }
      ]
    },
    "toolEnd": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "toolCallId"],
          "properties": {
            "type": { "const": "TOOL_CALL_END" },
            "toolCallId": { "type": "string" }
          }
        }
      ]
    },
    "toolResult": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId", "toolCallId", "content"],
          "properties": {
            "type": { "const": "TOOL_CALL_RESULT" },
            "messageId": { "type": "string" },
            "toolCallId": { "type": "string" },
            "content": { "type": "string" },
            "role": { "const": "tool" }
          }
        }
      ]
    },
    "stateSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "snapshot"],
          "properties": {
            "type": { "const": "STATE_SNAPSHOT" },
            "snapshot": {}
          }
        }
      ]
    },
    "stateDelta": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "delta"],
          "properties": {
            "type": { "const": "STATE_DELTA" },
            "delta": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        }
      ]
    },
    "messagesSnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messages"],
          "properties": {
            "type": { "const": "MESSAGES_SNAPSHOT" },
            "messages": { "type": "array", "items": {} }
          }
        }
      ]
    },
    "activitySnapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId", "activityType", "content"],
          "properties": {
            "type": { "const": "ACTIVITY_SNAPSHOT" },
            "messageId": { "type": "string" },
            "activityType": { "type": "string" },
            "content": {}
          }
        }
      ]
    },
    "activityDelta": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "messageId", "activityType", "patch"],
          "properties": {
            "type": { "const": "ACTIVITY_DELTA" },
            "messageId": { "type": "string" },
            "activityType": { "type": "string" },
            "patch": { "type": "array", "items": { "type": "object" } }
          }
        }
      ]
    },
    "custom": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "CUSTOM" },
            "name": {
              "type": "string",
              "pattern": "^agenthub\\.(plan|artifact|preview|context)\\.[a-z0-9_]+$"
            },
            "value": {}
          }
        }
      ]
    },
    "raw": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "event"],
          "properties": {
            "type": { "const": "RAW" },
            "event": {},
            "source": { "type": "string" }
          }
        }
      ]
    }
  }
}
