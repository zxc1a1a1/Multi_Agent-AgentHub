{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/llm-provider.schema.json",
  "title": "AgentHub LLM Provider Contract Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerDefinition"
      },
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelDefinition"
      },
      "minItems": 1
    }
  },
  "required": [
    "providers",
    "models"
  ],
  "$defs": {
    "providerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerName": {
          "type": "string",
          "minLength": 1
        },
        "providerType": {
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "openai_compatible",
            "local"
          ]
        },
        "status": {
          "enum": [
            "enabled",
            "disabled",
            "experimental",
            "deprecated"
          ]
        },
        "baseURL": {
          "type": "string"
        },
        "apiKeyEnv": {
          "type": "string"
        },
        "defaultModel": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "supportsStructuredOutput": {
          "type": "boolean"
        },
        "supportsToolUse": {
          "type": "boolean"
        }
      },
      "required": [
        "providerName",
        "providerType",
        "status",
        "timeoutMs",
        "supportsStreaming",
        "supportsStructuredOutput",
        "supportsToolUse"
      ]
    },
    "modelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "providerName": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "status": {
          "enum": [
            "enabled",
            "disabled",
            "deprecated"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "streaming": {
              "type": "boolean"
            },
            "structuredOutput": {
              "type": "boolean"
            },
            "jsonSchema": {
              "type": "boolean"
            },
            "toolUse": {
              "type": "boolean"
            },
            "vision": {
              "type": "boolean"
            },
            "reasoning": {
              "type": "boolean"
            }
          },
          "required": [
            "streaming",
            "structuredOutput",
            "jsonSchema",
            "toolUse",
            "vision",
            "reasoning"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxInputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "defaultTimeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "costClass": {
          "enum": [
            "free",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "modelId",
        "providerName",
        "status",
        "capabilities",
        "costClass"
      ]
    }
  }
}