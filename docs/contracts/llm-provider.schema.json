{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/llm-provider.schema.json",
  "title": "AgentHub LLM Provider Configuration",
  "type": "object",
  "required": [
    "providers",
    "models",
    "useCasePolicies"
  ],
  "properties": {
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "useCasePolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/useCasePolicy"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{0,127}$"
    },
    "useCase": {
      "type": "string",
      "enum": [
        "planner",
        "code_agent",
        "web_agent",
        "synthesizer",
        "conversation_summary",
        "auto_title"
      ]
    },
    "provider": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "timeoutMs",
        "supportsStreaming",
        "supportsStructuredOutput",
        "supportsToolUse"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/providerId"
        },
        "type": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "openai_compatible",
            "local",
            "mock"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "experimental",
            "deprecated"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "apiKeyRef": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "supportsStructuredOutput": {
          "type": "boolean"
        },
        "supportsToolUse": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "streaming",
        "structuredOutput",
        "jsonSchema",
        "toolUse",
        "vision",
        "reasoningOutput"
      ],
      "properties": {
        "streaming": {
          "type": "boolean"
        },
        "structuredOutput": {
          "type": "boolean"
        },
        "jsonSchema": {
          "type": "boolean"
        },
        "toolUse": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "reasoningOutput": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "providerId",
        "providerModel",
        "status",
        "capabilities",
        "maxInputTokens",
        "maxOutputTokens",
        "costClass"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/modelId"
        },
        "providerId": {
          "$ref": "#/$defs/providerId"
        },
        "providerModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "displayName": {
          "type": "string",
          "maxLength": 255
        },
        "status": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "deprecated"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "costClass": {
          "type": "string",
          "enum": [
            "free",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "retryPolicy": {
      "type": "object",
      "required": [
        "maxAttempts",
        "initialBackoffMs",
        "maxBackoffMs"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "initialBackoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "maxBackoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      },
      "additionalProperties": false
    },
    "structuredOutput": {
      "type": "object",
      "required": [
        "required",
        "localValidation"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "schemaId": {
          "type": "string",
          "maxLength": 255
        },
        "localValidation": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "useCasePolicy": {
      "type": "object",
      "required": [
        "useCase",
        "modelId",
        "temperature",
        "maxOutputTokens",
        "timeoutMs",
        "retryPolicy",
        "structuredOutput",
        "fallbackModelIds",
        "promptTemplateVersion"
      ],
      "properties": {
        "useCase": {
          "$ref": "#/$defs/useCase"
        },
        "modelId": {
          "$ref": "#/$defs/modelId"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        },
        "structuredOutput": {
          "$ref": "#/$defs/structuredOutput"
        },
        "fallbackModelIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modelId"
          }
        },
        "promptTemplateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "usageTags": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    }
  }
}
