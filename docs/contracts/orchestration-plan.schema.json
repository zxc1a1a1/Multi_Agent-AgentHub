{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/schemas/orchestration-plan.schema.json",
  "title": "AgentHub OrchestrationPlan",
  "type": "object",
  "required": [
    "version",
    "planId",
    "runId",
    "conversationId",
    "planningMode",
    "strategy",
    "intentSummary",
    "tasks",
    "fallback",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "conversationId": {
      "type": "string",
      "minLength": 1
    },
    "planningMode": {
      "type": "string",
      "enum": [
        "direct",
        "mention",
        "manual",
        "auto",
        "fallback"
      ]
    },
    "strategy": {
      "type": "string",
      "enum": [
        "single",
        "ordered_parallel",
        "sequential"
      ]
    },
    "intentSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/taskPlan"
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "message_per_task",
            "merged_summary",
            "none"
          ]
        },
        "summaryRequired": {
          "type": "boolean"
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "mode",
        "maxAttempts"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "same_capability_alternative",
            "lower_risk_plan",
            "single_agent_fallback",
            "fail_fast"
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "schemaVersion",
        "validated"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "v1"
        },
        "validated": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "taskPlan": {
      "type": "object",
      "required": [
        "taskId",
        "agentName",
        "capabilityIds",
        "taskContent",
        "dependsOn",
        "expectedOutputs"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "agentName": {
          "type": "string",
          "minLength": 1
        },
        "capabilityIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "taskContent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedOutputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
