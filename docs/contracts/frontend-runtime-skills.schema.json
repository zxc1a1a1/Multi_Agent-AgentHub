{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/frontend-runtime-skills.schema.json",
  "title": "AgentHub Frontend Runtime Skills Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtimeSkill"
      },
      "contains": {
        "type": "object",
        "required": [
          "name",
          "implemented"
        ],
        "properties": {
          "name": {
            "const": "code_preview"
          },
          "implemented": {
            "const": true
          }
        }
      }
    }
  },
  "$defs": {
    "skillName": {
      "enum": [
        "code_preview",
        "web_preview",
        "diff_preview",
        "file_download",
        "image_preview",
        "deploy_status",
        "markdown_render",
        "terminal_output",
        "chart_render",
        "form_input",
        "confirm_action",
        "file_upload"
      ]
    },
    "status": {
      "enum": [
        "implemented",
        "reserved",
        "disabled",
        "deprecated"
      ]
    },
    "behavior": {
      "enum": [
        "render",
        "interactive",
        "side_effect"
      ]
    },
    "failureMode": {
      "enum": [
        "fallback_card",
        "silent_ignore",
        "tool_result_error"
      ]
    },
    "runtimeSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "implemented",
        "status",
        "component",
        "parametersSchema",
        "behavior",
        "blocking",
        "requiresConfirmation",
        "dangerous",
        "allowedInMvp",
        "failureMode"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/skillName"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "implemented": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "parametersSchema": {
          "type": "object"
        },
        "resultSchema": {
          "type": "object"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "blocking": {
          "type": "boolean"
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "dangerous": {
          "type": "boolean"
        },
        "allowedInMvp": {
          "type": "boolean"
        },
        "failureMode": {
          "$ref": "#/$defs/failureMode"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "code_preview"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "implemented": {
                "const": true
              },
              "status": {
                "const": "implemented"
              },
              "component": {
                "const": "CodePreview"
              },
              "behavior": {
                "const": "render"
              },
              "blocking": {
                "const": false
              },
              "requiresConfirmation": {
                "const": false
              },
              "dangerous": {
                "const": false
              },
              "allowedInMvp": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "name": {
                  "const": "code_preview"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "then": {
            "properties": {
              "implemented": {
                "const": false
              },
              "allowedInMvp": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "behavior": {
                "const": "side_effect"
              }
            },
            "required": [
              "behavior"
            ]
          },
          "then": {
            "properties": {
              "requiresConfirmation": {
                "const": true
              },
              "dangerous": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "codePreviewParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "language",
        "filename"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frontendToolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolCallId",
        "skillName",
        "status"
      ],
      "properties": {
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "skillName": {
          "$ref": "#/$defs/skillName"
        },
        "status": {
          "enum": [
            "success",
            "cancelled",
            "failed"
          ]
        },
        "data": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "safeMessage"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "safeMessage": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": "v0.2-redesign",
      "skills": [
        {
          "name": "code_preview",
          "description": "Render read-only code content.",
          "implemented": true,
          "status": "implemented",
          "component": "CodePreview",
          "parametersSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "language",
              "filename"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              }
            }
          },
          "behavior": "render",
          "blocking": false,
          "requiresConfirmation": false,
          "dangerous": false,
          "allowedInMvp": true,
          "failureMode": "fallback_card"
        },
        {
          "name": "web_preview",
          "description": "Reserved web preview runtime skill.",
          "implemented": false,
          "status": "reserved",
          "component": "WebPreview",
          "parametersSchema": {
            "type": "object"
          },
          "behavior": "render",
          "blocking": false,
          "requiresConfirmation": false,
          "dangerous": false,
          "allowedInMvp": false,
          "failureMode": "fallback_card"
        }
      ]
    }
  ]
}
