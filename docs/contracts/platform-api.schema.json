{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/platform-api.schema.json",
  "title": "AgentHub Platform API Common Schemas",
  "description": "Platform API 通用响应、错误和资源摘要 schema。本 schema 是 openapi.yaml 的辅助约束，不替代 OpenAPI 事实源。",
  "type": "object",
  "$defs": {
    "SuccessEnvelope": {
      "type": "object",
      "required": [
        "code",
        "data",
        "message"
      ],
      "properties": {
        "code": {
          "const": 0
        },
        "data": {},
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "required": [
        "code",
        "data",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "data": {
          "type": "null"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Participant": {
      "type": "object",
      "required": [
        "type",
        "id",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AgentSummary": {
      "type": "object",
      "required": [
        "name",
        "displayName",
        "status",
        "health"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "enabled",
            "disabled",
            "experimental",
            "deprecated"
          ]
        },
        "health": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy",
            "unknown"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilitySummary"
          }
        },
        "inputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "CapabilitySummary": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SafeError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
