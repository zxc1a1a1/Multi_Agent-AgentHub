{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/observability-debugging.schema.json",
  "title": "AgentHub Structured Log Record",
  "type": "object",
  "required": [
    "timestamp",
    "level",
    "service",
    "message"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "service": { "type": "string", "minLength": 1 },
    "environment": { "type": "string" },
    "message": { "type": "string", "maxLength": 4096 },
    "requestId": { "type": "string" },
    "traceId": { "type": "string" },
    "conversationId": { "type": "string" },
    "messageId": { "type": "string" },
    "runId": { "type": "string" },
    "planId": { "type": "string" },
    "planVersion": { "type": "integer", "minimum": 1 },
    "stepId": { "type": "string" },
    "invocationId": { "type": "string" },
    "agentId": { "type": "string" },
    "agentVersion": { "type": "string" },
    "skillId": { "type": "string" },
    "contextSnapshotId": { "type": "string" },
    "artifactId": { "type": "string" },
    "artifactVersion": { "type": "integer", "minimum": 1 },
    "toolCallId": { "type": "string" },
    "providerRequestId": { "type": "string" },
    "eventSequence": { "type": "integer", "minimum": 0 },
    "errorCode": { "type": "string" },
    "retryable": { "type": "boolean" },
    "durationMs": { "type": "number", "minimum": 0 },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "anyOf": [
          { "required": ["authorization"] },
          { "required": ["apiKey"] },
          { "required": ["credential"] },
          { "required": ["chainOfThought"] },
          { "required": ["systemPrompt"] }
        ]
      }
    }
  ]
}
