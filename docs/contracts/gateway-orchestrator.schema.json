{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway Orchestrator Event",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "enum": [
        "RUN_STARTED",
        "RUN_FINISHED",
        "RUN_ERROR",
        "STATE_UPDATE",
        "TEXT_MESSAGE_START",
        "TEXT_MESSAGE_CONTENT",
        "TEXT_MESSAGE_END",
        "TOOL_CALL_START",
        "TOOL_CALL_ARGS",
        "TOOL_CALL_END"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tool_call_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "error": {
      "type": "string"
    }
  }
}
