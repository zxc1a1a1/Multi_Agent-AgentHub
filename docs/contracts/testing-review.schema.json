{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/testing-review.schema.json",
  "title": "AgentHub Test and Review Evidence",
  "type": "object",
  "required": [
    "scope",
    "contracts",
    "tests",
    "verdict"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "required": [
        "modified",
        "created",
        "deleted"
      ],
      "properties": {
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deleted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securityNegatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "APPROVED_WITH_FOLLOW_UP",
        "CHANGES_REQUESTED",
        "REJECTED"
      ]
    }
  },
  "additionalProperties": false
}
