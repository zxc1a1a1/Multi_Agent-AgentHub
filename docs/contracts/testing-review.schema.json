{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/testing-review.schema.json",
  "title": "AgentHub Testing Review Contract Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles",
    "gates",
    "reviewChecklists"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)?$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "current",
              "historical",
              "planned"
            ]
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "blocking",
          "testTypes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "name": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "testTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredFixtures": {
            "type": "array",
            "items": {
              "enum": [
                "valid",
                "invalid",
                "replay",
                "golden",
                "mock",
                "fake"
              ]
            }
          },
          "forbiddenDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "reviewChecklists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
