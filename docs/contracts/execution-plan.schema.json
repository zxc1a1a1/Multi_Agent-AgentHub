{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthub.local/contracts/execution-plan.schema.json",
  "title": "AgentHub ExecutionPlan Contract",
  "description": "MVP schema for AgentHub intent orchestration ExecutionPlan. MVP only supports single direct routing to code-agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "strategy",
    "tasks"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "messageId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "single",
        "parallel",
        "sequential"
      ]
    },
    "reason": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "aggregation": {
      "$ref": "#/$defs/aggregation"
    },
    "fallback": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fallback"
        }
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "single"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "properties": {
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agent",
        "skill",
        "input"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requiredArtifacts": {
          "type": "array",
          "items": {
            "enum": [
              "code",
              "webpage",
              "diff",
              "file",
              "image",
              "deploy",
              "document",
              "terminal",
              "chart"
            ]
          },
          "uniqueItems": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "preserve_order",
            "summarize",
            "merge_artifacts",
            "select_best",
            "user_choose"
          ]
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fallbackAgent": {
          "type": "string"
        },
        "fallbackSkill": {
          "type": "string"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": "v0.1",
      "strategy": "single",
      "reason": "Direct routing to selected code-agent.",
      "tasks": [
        {
          "id": "task_1",
          "agent": "code-agent",
          "skill": "code_generate",
          "input": {
            "message": "帮我写一个 Go HTTP 服务器"
          },
          "dependsOn": [],
          "requiredArtifacts": [
            "code"
          ]
        }
      ],
      "fallback": null
    }
  ]
}