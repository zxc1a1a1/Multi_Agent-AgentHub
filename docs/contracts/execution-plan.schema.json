{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrchestrationPlan",
  "type": "object",
  "required": [
    "mode",
    "steps"
  ],
  "properties": {
    "mode": {
      "enum": [
        "single",
        "sequential",
        "parallel",
        "ordered_parallel"
      ]
    },
    "intent": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "agentName",
          "input"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedOutputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
