{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHub New Architecture Contract",
  "type": "object",
  "required": [
    "modules",
    "communications",
    "legacyPaths"
  ],
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "enum": [
          "pkg/adk",
          "pkg/runtime",
          "services/gateway",
          "services/orchestrator",
          "services/agents",
          "frontend"
        ]
      }
    },
    "communications": {
      "type": "object",
      "properties": {
        "frontendGateway": {
          "const": "AG-UI/SSE"
        },
        "gatewayOrchestrator": {
          "enum": [
            "gRPC streaming",
            "temporary HTTP/SSE compatibility"
          ]
        },
        "orchestratorAgents": {
          "const": "A2A"
        }
      }
    },
    "legacyPaths": {
      "type": "array",
      "items": {
        "enum": [
          "server/**",
          "agents/**"
        ]
      }
    }
  }
}
