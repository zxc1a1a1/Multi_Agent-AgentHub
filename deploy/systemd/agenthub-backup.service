[Unit]
Description=AgentHub MySQL and artifact backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agenthub-backup
Group=agenthub-backup
EnvironmentFile=/etc/agenthub/backup.env
ExecStart=/opt/agenthub/scripts/backup-agenthub.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/agenthub
